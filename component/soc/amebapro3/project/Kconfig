comment "--------Build Config---------"

menu "Build Option"
    config FPGA
        bool "Select FPGA"
        depends on !AMEBA_RLS
        default n

	if FPGA
		comment "Choose the FPGA bitfile version"
		choice
			prompt "FPGA BIT VERSION"
			default BIT_V14

			config BIT_V14
				bool "V14"

			config BIT_V10
				bool "V10"

			comment "for V5/V6/V9"
			config BIT_V6
				bool "V6"
		endchoice

		comment "SRAM only mode for FPGA one AXF, not valid in ASIC"
		config SRAM_ONLY
			bool "SRAM Only"

		config NO_RCC
			bool "RCC invalid"
			default n
	endif

    config PXP
        bool "Select PXP"
        depends on !AMEBA_RLS
        default n

	if PXP
		config NO_RCC
			bool "RCC invalid"
			default n
	endif

    config FT2_VERIFY
        bool "Select FT2_VERIFY"
        depends on !AMEBA_RLS
        default n

    config OLT_VERIFY
        bool "Select OLT_VERIFY"
        depends on !AMEBA_RLS
        default n    

	choice
		prompt "Chip Version"
		default AMEBAPRO3_A_CUT
		config AMEBAPRO3_A_CUT
			bool "AMEBAPRO3_A_Cut"

		config AMEBAPRO3_B_CUT
			bool "AMEBAPRO3_B_Cut"
	endchoice

	config ROM
		bool "Build ROM only [not update rom_symobl]"
		depends on !AMEBA_RLS
		depends on !FPGA || !PXP
		default n
	if ROM || FPGA || PXP
		choice
			prompt "Building Rom Version"
			default ROM_V1
			config ROM_V1
				bool "ROM_V1 for A-CUT"

			config ROM_V2
				bool "ROM_V2 for B-CUT"
		endchoice
	endif

	menu "CONFIG Linux"
		config LINUX_FW_EN
			bool "Support Linux"
			help
				Enable this option to support linux firmware loading. Build, BL1 only, no RTOS FIP

			default n
	endmenu
    
	choice 
		prompt "4K ISP Mode"
		default 4K_OFF

		config 4K_OFF
			bool "Disable 4K ISP"
		config 4K_DEV
        	bool "Develop 4K ISP"
			depends on DDR_128M
			depends on LOADMP
			help
			  Enable the 128 MiB DDR layout for 4K ISP development on VP.
			  LOADAP is optional: enable it for AP-controlled streaming,
			  or use the standalone VP ISP -> encoder -> UVC example.
			  The standalone path requires SUPPORT_UVC_TUNING_FOR_VP
			  (which selects VP_MEDIA_EXAMPLE) and USBD_UVC in the VP
			  configuration. Start it with the VP console command
			  "video run"; selecting 4K_DEV alone does not auto-start video.
			  AP DDR regions remain reserved even when LOADAP is disabled.
		config 4K_ENA
			bool "Enable 4K ISP"
			depends on DDR_256M
			depends on LOADMP
	endchoice
endmenu

