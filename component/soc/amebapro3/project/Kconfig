orsource "../../../soc/common/image3/Kconfig.trustzone"

menu "CONFIG Memory Arch"
	if !LOADMP && !LOADAP
		config DISABLE_PSRAM
			bool "DISABLE PSRAM"
			default n

		if !DISABLE_PSRAM
			config PSRAM_CAL
				bool "Enable PSRAM calibration"
				default n
		endif

		config DISABLE_DDR
			bool "DISABLE DDR"
			default n
	endif

	if !DISABLE_DDR
		choice
			prompt "DDR Size"
			default DDR_128M
			
			config DDR_128M
				bool "128M"
				
			config DDR_256M
				bool "256M"
		endchoice
		choice
			prompt "DDR_PHY Frequency"
			default DDR_PHY_FREQ_933MHZ

			config DDR_PHY_FREQ_933MHZ
				bool "933MHz"

			config DDR_PHY_FREQ_900MHZ
				bool "900MHz"

			config DDR_PHY_FREQ_850MHZ
				bool "850MHz"

			config DDR_PHY_FREQ_800MHZ
				bool "800MHz"

			config DDR_PHY_FREQ_533MHZ
				bool "533MHz"
		endchoice

		menuconfig DDR_ODT_ENABLE
			bool "Enable DDR ODT"
			default y

		if DDR_ODT_ENABLE
			config DRAM_DIE_ODT_ENABLE
				bool "Enable DRAM-side ODT (MR2.RTT_WR)"
				default y

			config DDR_PHY_ODT_ENABLE
				bool "Enable PHY-side ODT (calibrated pad termination)"
				default y
		endif

		config DDR_PHY_THREE_POINT_K_ENABLE
			bool "Enable DDR PHY Three Point K"
			default n

		config DDR_ENABLE_SET_PRIORITY
			bool "Eanble DDRC QoS priority"
			default y

		config DDR_ENABLE_SET_NONCE
			bool "Setup DDRC secure zone nonces"
			default n
	endif
	if LOADMP || LOADAP
		comment "Cannot disable PSRAM or DDR when LOADMP or LOADAP selected"
	endif
endmenu

menu "CONFIG Link Option"
    choice
        prompt "IMG1(Bootloader) running on SRAM?"
        default IMG1_SRAM
        config IMG1_SRAM
            bool "SRAM"
    endchoice

    choice
        prompt "IMG2(FP Application) running on SRAM"
        default IMG2_SRAM_FOR_FP
        config IMG2_SRAM_FOR_FP
            bool "SRAM"
    endchoice

    choice
        prompt "IMG2(NP Application) running on PSRAM"
        default IMG2_PSRAM_FOR_NP
        config IMG2_PSRAM_FOR_NP
            bool "PSRAM"
    endchoice

    choice
        prompt "IMG2(VP Application) running on PSRAM?"
        default IMG2_PSRAM_FOR_VP
        config IMG2_PSRAM_FOR_VP
            bool "PSRAM"
    endchoice

	choice
        prompt "IMG2(AP Application) running on DDR?"
        default IMG2_DDR_FOR_AP
        config IMG2_DDR_FOR_AP
            bool "DDR"
    endchoice

    if TRUSTZONE
        choice
            prompt "NP IMG3(SecureImage) running on PSRAM?"
            default IMG3_PSRAM_FOR_NP
            config IMG3_PSRAM_FOR_NP
                bool "PSRAM"
        endchoice
    endif

    config PSRAM_ALL_FOR_AP_HEAP
        def_bool n
endmenu

menu "CONFIG Mass Production"
    config MP_INCLUDED
        bool "Enable MP"
    if MP_INCLUDED
        choice
            prompt "MP Mode"
            default MP_SHRINK
            config MP_EXPAND
                bool "expand"
            config MP_SHRINK
                bool "shrink"
        endchoice
    endif
endmenu

