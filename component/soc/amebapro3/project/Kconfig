menu "CONFIG VIDEO SOFTWARE"

	config VIDEO_SW
		bool "ENABLE VIDEO SOFTWARE"
		default y
		select FREERTOS_POSIX
	if VIDEO_SW
		orsource "../../../soc/amebapro3/video/Kconfig"
		config BUILD_VIDEO_TEST_TOOL
			bool "Build Video Test Tool"
			default n
		config BUILD_ISP_SRAM_TEST
			bool "UART ISP to H264 frame/SRAM comparison"
			depends on !4K_DEV && !FAST_CAMERA_START_FOR_AP
			select BUILD_VIDEO_TEST_TOOL
			select VMODULE_ADDREMAP
			default n
	endif
	config FAST_CAMERA_START_FOR_AP
		bool "ENABLE FAST CAMERA START (FCS)"
		depends on VIDEO_SW && LOADAP && LOADMP
		default n
		select FAST_CAMERA_START_FOR_VP
	config FAST_CAMERA_START_FOR_VP
		bool
endmenu

menu "CONFIG AUDIO SOFTWARE"

    config AUDIO_SW
		bool "ENABLE AUDIO SOFTWARE"
		default y
	if AUDIO_SW
        orsource "../../../soc/amebapro3/audio/Kconfig"
        orsource "../../../soc/amebapro3/sw/media_example/ap_media_example/audio_example_src/audio_test_tool/Kconfig"
	endif
endmenu

comment "-----Connectivity Config-----"
menu "CONFIG WHC INTF"
    depends on WLAN_MENU
    choice
        prompt "WHC MODE"
        default WHC_INTF_IPC_MENU
			config WHC_INTF_IPC_MENU
				bool "WHC_IPC"
				select WHC_DEV_FOR_NP
				select WHC_HOST_FOR_AP
			config WIFI_SINGLE_CORE_MENU
				bool "SINGLE CORE"
				select WHC_NONE_FOR_NP
    endchoice

    if WHC_INTF_IPC_MENU && !LINUX_FW_EN
        config WHC_DEV_TCPIP_KEEPALIVE
            bool "Enable NP TCP/IP keep-alive (bridge mode)"
            default y
            select MBEDTLS_ENABLED if WHC_DEV && MBEDTLS_ENABLED_MENU
            select MBEDTLS_SSL_PROTO_TLS1_3 if WHC_DEV && MBEDTLS_SSL_PROTO_TLS1_3_MENU
    endif

    config WHC_HOST_FOR_AP
        bool
    config WHC_DEV_FOR_NP
        bool
    config WHC_HOST_FOR_NP
        bool
    config WHC_NONE_FOR_NP
        bool
    config WHC_WPA_SUPPLICANT_OFFLOAD_FOR_NP
        bool "WPA supplicant offload to device (NP)"
        default y
        depends on WHC_DEV_FOR_NP && WHC_INTF_IPC_MENU && !MP_SHRINK
    config WHC_WIFI_API_PATH
        bool
	config WHC_NONE_FOR_AP
        bool
	config WHC_NONE_FOR_VP
        bool
    config MBEDTLS_SSL_IN_CONTENT_LEN
        int
        default MBEDTLS_SSL_IN_CONTENT_LEN_MENU if WHC_DEV && WHC_DEV_TCPIP_KEEPALIVE && MBEDTLS_ENABLED_MENU
        default 16384 if WHC_DEV && WHC_DEV_TCPIP_KEEPALIVE
    config MBEDTLS_SSL_OUT_CONTENT_LEN
        int
        default MBEDTLS_SSL_OUT_CONTENT_LEN_MENU if WHC_DEV && WHC_DEV_TCPIP_KEEPALIVE && MBEDTLS_ENABLED_MENU
        default 4096 if WHC_DEV && WHC_DEV_TCPIP_KEEPALIVE
endmenu

menu "CONFIG WIFI"
    config WLAN_MENU
        bool "Enable Wifi"
        default y

    if WLAN_MENU

        rsource "../../../wifi/Kconfig.wifi"

        config WHC_INTF_IPC_MENU
            bool
            select WHC_INTF_IPC
            select WHC_WIFI_API_PATH
            select WLAN_FOR_NP if WHC_HOST||WHC_DEV
			select WLAN_FOR_AP if WHC_HOST||WHC_DEV
            select LWIP_LAYER_FOR_AP if WHC_HOST && !MP_SHRINK
            select LWIP_LAYER_FOR_NP if WHC_DEV_TCPIP_KEEPALIVE
            select ENABLE_WPS if WHC_HOST && WIFI_WPS_ENABLE_MENU
            select ENABLE_WPS_DISCOVERY if ENABLE_WPS
            select LWIP_NETCONN_SEM_PER_THREAD if WHC_HOST

        config WIFI_SINGLE_CORE_MENU
            bool
            #depends on WHC_NONE
            select WLAN_FOR_NP
            select LWIP_LAYER_FOR_NP
            select ENABLE_WPS if WIFI_WPS_ENABLE_MENU
            select ENABLE_WPS_DISCOVERY if ENABLE_WPS

    endif

    if !WLAN_MENU
        config WLAN_DISABLE
            bool
    endif


    config WLAN
        bool
	config WLAN_FOR_NP
		bool
	config WLAN_FOR_AP
		bool
    config WHC_INTF_IPC
        bool
    config LWIP_LAYER
        bool
    config LWIP_LAYER_FOR_NP
        bool
    config LWIP_LAYER_FOR_AP
        bool
    config WHC_INTF_SPDIO
        bool
    config WHC_INTF_SPI
        bool
    config WHC_INTF_USB
        bool
    config WIFI_FW_EN
        bool
    config ENABLE_WPS
        bool
    config ENABLE_WPS_DISCOVERY
        bool
    config LWIP_NETCONN_SEM_PER_THREAD
        bool

endmenu

