foreach(name ${module_files})
    string(REGEX REPLACE "isp_mod_" "" name ${name})
    string(REPLACE ".c" "" name ${name})
    list(APPEND modules "${name}")
endforeach()

set(name isp_modules.c)
set(content "/* Auto generated by cmake. Please do not modify! */

#include <isp_mod.h>

typedef int (*reg_mod_func)(void);
typedef void (*unreg_mod_func)(void);

#define MODULES_REG_FUNC_DECLARATION(mod) \\
int isp_register_mod_##mod(void); \\
void isp_unregister_mod_##mod(void);

")

### generate function declarations ###
foreach(mod ${modules})
    string(APPEND content "MODULES_REG_FUNC_DECLARATION(${mod});\n")
endforeach()

### generate register function array ###
string(APPEND content "\nstatic reg_mod_func reg_mod_funcs[] = {\n")
foreach(mod ${modules})
    string(APPEND content "\tisp_register_mod_${mod},\n")
endforeach()
string(APPEND content "};\n")

### generate unregister function array ###
string(APPEND content "\nstatic unreg_mod_func unreg_mod_funcs[] = {\n")
foreach(mod ${modules})
    string(APPEND content "\tisp_unregister_mod_${mod},\n")
endforeach()
string(APPEND content "};\n")

string(APPEND content "
int isp_register_all_modules(void)
{
	int i;
	int ret;

	for (i = 0; i < ARRAY_SIZE(reg_mod_funcs); i++) {
		ret = reg_mod_funcs[i]();
		if (ret)
			break;
	}
	if (ret)
		isp_unregister_all_modules();

	return ret;
}

void isp_unregister_all_modules(void)
{
	int i;

	for (i = 0; i < ARRAY_SIZE(unreg_mod_funcs); i++)
		unreg_mod_funcs[i]();
}
")

file(WRITE ${name} "${content}")
